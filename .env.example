# ============================================================
# Lakán DLSU-D (`lakan_dlsud`) — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).
# ============================================================

# ---- Database (PostgreSQL — required) ----
# Local:  postgresql://lakan:lakan@localhost:5432/lakan_db
# Neon:   copy the connection string from the Neon dashboard
DATABASE_URL=postgresql://lakan:lakan@localhost:5432/lakan_db

# ---- Admin account (environment-driven — zero accounts committed to git) ----
# seed.py creates this admin ONLY if both are set; /api/admin/create uses ADMIN_SETUP_TOKEN
# ADMIN_EMAIL=you@dlsud.edu.ph
# ADMIN_PASSWORD=a-long-password
# ADMIN_SETUP_TOKEN=

# ---- Chatbot LLM (required for general chat) ----
# https://platform.deepseek.com/ (pay-as-you-go, very cheap)
DEEPSEEK_API_KEY=

# ---- RAG embeddings (optional but recommended) ----
# Free key: https://aistudio.google.com/apikey → enables vector search over
# uploaded memos. Without it the chatbot falls back to keyword search.
GEMINI_API_KEY=

# ---- Building detection (required for /camera) ----
# Roboflow hosted inference. !! Rotate the old keys that leaked in the
# !! public repo at https://app.roboflow.com/settings before deploying.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=lakan-5ugrp/1
# Detections below this confidence are dropped (0.0–1.0)
ROBOFLOW_MIN_CONFIDENCE=0.40

# ---- Flask ----
FLASK_SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
